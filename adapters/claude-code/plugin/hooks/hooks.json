{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "agent-monitor-claude-hook", "timeout": 1 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "agent-monitor-claude-hook", "timeout": 1 }] }],
    "PreToolUse": [{ "hooks": [{ "type": "command", "command": "agent-monitor-claude-hook", "timeout": 1 }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "agent-monitor-claude-hook", "timeout": 1 }] }],
    "PostToolUseFailure": [{ "hooks": [{ "type": "command", "command": "agent-monitor-claude-hook", "timeout": 1 }] }],
    "PermissionRequest": [{ "hooks": [{ "type": "command", "command": "agent-monitor-claude-hook", "timeout": 1 }] }],
    "Notification": [
      { "matcher": "permission_prompt", "hooks": [{ "type": "command", "command": "agent-monitor-claude-hook", "timeout": 1 }] },
      { "matcher": "idle_prompt", "hooks": [{ "type": "command", "command": "agent-monitor-claude-hook", "timeout": 1 }] }
    ],
    "Stop": [{ "hooks": [{ "type": "command", "command": "agent-monitor-claude-hook", "timeout": 1 }] }],
    "StopFailure": [{ "hooks": [{ "type": "command", "command": "agent-monitor-claude-hook", "timeout": 1 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "agent-monitor-claude-hook", "timeout": 1 }] }]
  }
}
